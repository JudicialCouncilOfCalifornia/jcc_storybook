<a
  class="site-branding"
  href="{{ url|default('/') }}"
  aria-label="{{ label }} {{ sub_label }} homepage"
>
  <div class="site-branding__container cluster">
    <div class="site-branding__logo">
      <img src='{{ logo }}' alt="" />
    </div>
    <div class="site-branding__labels">
        <div class="site-branding__label">
          {{ label }}
        </div>
        <div class="site-branding__sub-label">
          {{ sub_label }}
        </div>
    </div>
  </div>
</a>
