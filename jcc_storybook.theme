<?php

/**
 * @file
 * Functions to support theming in the jcc_professional theme.
 */

// Include all files from the includes directory.
$includes_path = dirname(__FILE__) . '/includes/*.inc';
foreach (glob($includes_path) as $filename) {
  require_once dirname(__FILE__) . '/includes/' . basename($filename);
}

/**
 * Implements hook_library_info_build().
 *
 * Drupal 11 no longer invokes this hook for themes, see
 * jcc_storybook_library_info_alter().
 */
function jcc_storybook_library_info_build() {
  return _jcc_storybook_story_libraries();
}

/**
 * Implements hook_library_info_alter().
 *
 * Registers the story libraries on Drupal 11, where themes can still alter
 * library definitions but hook_library_info_build() only runs for modules.
 */
function jcc_storybook_library_info_alter(&$libraries, $extension) {
  if ($extension === 'jcc_storybook') {
    $libraries += _jcc_storybook_story_libraries();
  }
}

/**
 * Builds a library for each story CSS and JS file in lib/stories.
 */
function _jcc_storybook_story_libraries() {
  $extensions = ['css', 'js'];
  $directory = 'themes/contrib/jcc_storybook/lib/stories';
  $extensions = array_map('preg_quote', $extensions);
  $extensions = implode('|', $extensions);
  $libraries = [];
  $file_scan = \Drupal::service('file_system')->scanDirectory($directory, "/{$extensions}$/");

  foreach ($file_scan as $file) {
    $parts = explode('.', $file->filename);
    $extension = end($parts);

    switch ($extension) {
      case 'css':
        $libraries[$file->name][$extension] = [
          'component' => [
            '/' . $file->uri => [],
          ],
        ];
        break;
      case 'js':
        $libraries[$file->name][$extension] = [
          '/' . $file->uri => [],
        ];
        break;
    }
  }

  return $libraries;
}
